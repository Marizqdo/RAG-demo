cat > .env.example << 'EOF'
# Copia este archivo como .env y ajusta los valores
# cp .env.example .env

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelos
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
TOP_K_RESULTS=4
EOF